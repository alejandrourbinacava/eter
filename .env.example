# Copia este fichero a .env y rellena los valores. .env está en .gitignore.
# En GitHub, los mismos nombres van en Settings → Secrets and variables → Actions.

# --- Obligatorios ---------------------------------------------------------

# Guion. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voz. ai33.pro → Ajustes → API Key (requiere créditos premium)
AI33_API_KEY=

# --- Publicación (ver scripts/get_youtube_token.py) -----------------------

YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Opcionales pero muy recomendados -------------------------------------
# Sin estas dos claves el pipeline funciona, pero se queda sin bancos de vídeo
# y tira casi todo el rato del archivo fotográfico de la NASA.

# https://www.pexels.com/api/  (gratis, inmediata)
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  (gratis, inmediata)
PIXABAY_API_KEY=

# --- Ajustes --------------------------------------------------------------

# public | unlisted | private
ETER_PRIVACY=public
ETER_TARGET_MINUTES=14
ETER_VOICE_ID=elevenlabs_PToUZ7lhIUiz1SP94rGo
